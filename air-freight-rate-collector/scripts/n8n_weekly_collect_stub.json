{
  "name": "Air Freight Weekly Collect",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1 }]
        }
      },
      "name": "Weekly Sunday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "cd {{$env.AIR_FREIGHT_COLLECTOR_DIR}} && python -m src.run_collect --all && python -m src.forecast_proxy_baseline"
      },
      "name": "Run collectors",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "notice": "Copy data/processed/*.csv to SharePoint or Fabric Lakehouse, then refresh Power BI."
      },
      "name": "Note: sync to Fabric",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Weekly Sunday": {
      "main": [[{ "node": "Run collectors", "type": "main", "index": 0 }]]
    },
    "Run collectors": {
      "main": [[{ "node": "Note: sync to Fabric", "type": "main", "index": 0 }]]
    }
  }
}
